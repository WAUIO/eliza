{
    "name": "@elizaos/agent",
    "version": "0.25.9",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "start": "node --loader ts-node/esm src/index.ts",
        "dev": "node --loader ts-node/esm src/index.ts",
        "check-types": "tsc --noEmit",
        "test": "jest"
    },
    "nodemonConfig": {
        "watch": [
            "src",
            "../core/dist"
        ],
        "ext": "ts,json",
        "exec": "node --enable-source-maps --loader ts-node/esm src/index.ts"
    },
    "dependencies": {
        "@elizaos/client-direct": "workspace:*",
        "@elizaos/core": "workspace:*",
        "@elizaos/client-telegram": "github:elizaos-plugins/client-telegram",
        "@elizaos/plugin-image": "github:elizaos-plugins/plugin-image",
        "@elizaos/client-twitter": "github:elizaos-plugins/client-twitter",
        "@elizaos/plugin-twitter": "github:elizaos-plugins/plugin-twitter",
        "@elizaos/plugin-bootstrap": "workspace:*",
        "readline": "1.3.0",
        "ws": "8.18.0",
        "cors": "2.8.5",
        "@types/node": "^22.13.5",
        "json5": "2.2.3",
        "ts-node": "^10.9.2",
        "yargs": "17.7.2"
    },
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "@types/jest": "^29.5.14",
        "jest": "^29.7.0",
        "tsup": "8.3.5",
        "@types/cors": "2.8.14",
        "ts-jest": "^29.2.6"
    }
}